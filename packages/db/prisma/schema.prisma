generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 인증된 운영자. 관리자 기능과 신청자 데이터 접근 주체.
model Operator {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  templates HtmlTemplate[]
  campaigns Campaign[]

  @@map("operators")
}

/// 운영자가 AI로 만들어 등록한 단일 .html 파일. 원문 그대로 보관.
model HtmlTemplate {
  id         String   @id @default(uuid())
  operatorId String
  name       String
  html       String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  forms    Form[]

  @@index([operatorId])
  @@map("html_templates")
}

/// 캠페인. 성과 집계의 최상위 단위.
model Campaign {
  id          String   @id @default(uuid())
  operatorId  String
  name        String
  description String?
  createdAt   DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  forms    Form[]

  @@index([operatorId])
  @@map("campaigns")
}

enum FormStatus {
  ACTIVE
  PAUSED
}

/// 캠페인 + HTML 템플릿 조합으로 만든 커스텀 신청 폼. 공개 URL 단위.
model Form {
  id         String     @id @default(uuid())
  campaignId String
  templateId String
  name       String
  slug       String     @unique
  status     FormStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())

  campaign    Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template    HtmlTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  links       DistributionLink[]
  events      Event[]
  submissions Submission[]

  @@index([campaignId])
  @@map("forms")
}

enum Channel {
  INSTAGRAM
  X
  YOUTUBE
  THREADS
}

/// 채널별 배포 링크. /l/{code} 로 접근. 코드만 노출되어 채널 조작 불가.
model DistributionLink {
  id        String   @id @default(uuid())
  formId    String
  channel   Channel
  code      String   @unique
  createdAt DateTime @default(now())

  form        Form         @relation(fields: [formId], references: [id], onDelete: Cascade)
  events      Event[]
  submissions Submission[]

  @@index([formId])
  @@map("distribution_links")
}

/// 퍼널 이벤트. 단계 = 해당 type 을 1회 이상 낸 고유 visitorId 수 (ADR-0007).
/// VIEW·SUBMIT_SUCCESS 는 서버가, 나머지는 공개 폼의 주입 스크립트가 기록한다.
enum EventType {
  VIEW            // GET /l/:code 200 (링크 클릭)
  FORM_VIEW       // 주입 스크립트 실행 + <form> 발견 (폼 도달)
  FORM_START      // 첫 입력 (작성 시작)
  SUBMIT_ATTEMPT  // submit 이벤트 (제출 시도)
  SUBMIT_ERROR    // 제출 실패 (meta.reason / meta.status)
  SUBMIT_SUCCESS  // POST /f/:slug/submissions 201 (신청 완료)
}

model Event {
  id        String    @id @default(uuid())
  formId    String
  linkId    String?
  visitorId String
  type      EventType
  meta      Json?
  ipHash    String?
  userAgent String?
  createdAt DateTime  @default(now())

  form Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  link DistributionLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([formId, type, createdAt])
  @@index([formId, visitorId])
  @@index([visitorId, createdAt])
  @@index([linkId])
  @@map("events")
}

/// 신청 1건 = CRM 명단 행. payload 는 폼 필드 전체 (name/value).
model Submission {
  id        String   @id @default(uuid())
  formId    String
  linkId    String?
  visitorId String?
  payload   Json
  ipHash    String?
  createdAt DateTime @default(now())

  form Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  link DistributionLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([formId, createdAt])
  @@index([linkId])
  @@map("submissions")
}
