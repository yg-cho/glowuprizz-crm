{
  "name": "glowuprizz",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @glowuprizz/db generate",
    "db:migrate": "pnpm --filter @glowuprizz/db migrate:dev",
    "db:deploy": "pnpm --filter @glowuprizz/db migrate:deploy",
    "db:seed": "pnpm --filter @glowuprizz/db seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
