# ---- shared
DATABASE_URL=postgresql://glow:glow@localhost:5432/glowuprizz
NODE_ENV=development

# ---- apps/api (:3001)
JWT_SECRET=dev-jwt-secret-0123456789abcdef0123456789abcdef
# 관리자 웹 origin (CORS 허용). 콤마 구분 복수 가능
WEB_ORIGIN=http://localhost:3000
# 공개 폼 서버 origin. 배포 링크 URL 생성에 사용. 관리자와 반드시 다른 origin
FORMS_PUBLIC_ORIGIN=http://127.0.0.1:3002

# ---- apps/forms (:3002)
# 16자 이상 필수 (미설정·짧으면 forms 기동 실패). 공개 폼 POST 토큰 키도 여기서 파생
IP_HASH_SALT=dev-salt-change-me-0123456789

# ---- apps/web (:3000)
NEXT_PUBLIC_API_URL=http://localhost:3001
# 서버 컴포넌트에서 api 호출 시 내부 주소 (docker 네트워크 등). 미설정 시 NEXT_PUBLIC_API_URL
API_INTERNAL_URL=http://localhost:3001

# ---- tests
TEST_DATABASE_URL=postgresql://glow:glow@localhost:5433/glowuprizz_test

# ---- seed
SEED_OPERATOR_EMAIL=admin@glowuprizz.com
SEED_OPERATOR_PASSWORD=Password123!
